{
  "name": "lemon-dashboard",
  "private": true,
  "version": "6.9.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "bash dev-full.sh",
    "deploy:functions": "npm --prefix functions run build && firebase deploy --only functions",
    "prebuild": "node scripts/check-intelligence-publication.mjs && rm -rf dist/assets",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "TMPDIR=./.tmp node --require ./src/test/fix-eperm.cjs ./node_modules/.bin/vitest",
    "test:run": "TMPDIR=./.tmp node --require ./src/test/fix-eperm.cjs ./node_modules/.bin/vitest run",
    "test:coverage": "TMPDIR=./.tmp node --require ./src/test/fix-eperm.cjs ./node_modules/.bin/vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:auth": "playwright test e2e/intelligence-briefing.spec.ts --grep authorization",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:env": "bash scripts/check-test-environment.sh",
    "test:python": "PYTHONPATH=. .venv/bin/python -m unittest discover -s execution -p 'test_*.py'",
    "test:rules": "bash scripts/with-java-21.sh firebase emulators:exec --only firestore,storage \"vitest run --config vitest.rules.config.ts\"",
    "test:full": "npm run test:env && npm run test:run && npm --prefix functions test && npm run test:python && npm run test:rules",
    "deploy": "npm run build && firebase deploy --only hosting",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "lint:legacy": "bash scripts/check-legacy-refs.sh",
    "models:check": "node scripts/check-anthropic-models.mjs",
    "models:check:offline": "node scripts/check-anthropic-models.mjs --offline",
    "models:refresh": "node scripts/check-anthropic-models.mjs --write-observed",
    "models:test": "node --test scripts/check-anthropic-models.test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@react-pdf/renderer": "^4.3.2",
    "@tanstack/react-query": "^5.90.20",
    "clsx": "^2.1.1",
    "firebase": "^12.9.0",
    "i18next": "^26.3.6",
    "jszip": "^3.10.1",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.7.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.39.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.58.1",
    "@tailwindcss/vite": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.9",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.8",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.6.1",
    "jsdom": "^27.4.0",
    "pdf-parse": "^1.1.4",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  }
}

# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Paperclip API access for live agent data on the War Room dashboard.
# If not set, the Agent Board and Agent Roster sections will not render.
VITE_PAPERCLIP_API_URL=
VITE_PAPERCLIP_COMPANY_ID=
VITE_PAPERCLIP_API_KEY=

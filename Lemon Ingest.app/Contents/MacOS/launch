#!/bin/bash
# Lemon Batch Ingest - native folder choices, then the restart-safe CLI.

PROJECT_DIR="/Users/quantumcode/CODE/LEMON-SCREENPLAY-DASHBOARD"
PYTHON="/usr/bin/python3"
CLI_PYTHON="$PROJECT_DIR/ingest/.venv/bin/python"
SCRIPT="$PROJECT_DIR/ingest/app.py"

if [ ! -x "$CLI_PYTHON" ]; then
  osascript -e 'display alert "Lemon Batch Ingest needs setup" message "Run pip install -r ingest/requirements.txt in the project first."'
  exit 1
fi

cd "$PROJECT_DIR" || exit 1
exec "$PYTHON" "$SCRIPT"

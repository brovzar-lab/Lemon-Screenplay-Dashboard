rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
// Lemon Screenplay Dashboard — Firestore Security Rules (Hardened)
//
// SECURITY MODEL (2026-07-20):
//   • Dashboard access requires verified @lemonfilms.com Google identity.
//   • Roles live in users/{uid}: admins manage data; readers review/share.
//   • Destructive operations (delete, bulk update) are Admin-SDK-only where
//     possible. For collections where the browser needs soft-delete (update
//     with _deleted_at), we allow update but block hard delete.
//   • The VPS daemon and Cloud Functions use the Admin SDK, which bypasses
//     all security rules entirely — no client-side rules needed for them.
//
// ADMIN SDK NOTE:
//   The Admin SDK (used by the VPS daemon and Cloud Functions) bypasses
//   all security rules. Rules below only govern browser/client access.
// ═══════════════════════════════════════════════════════════════════════════

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────

    function isLemonIdentity() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email_verified == true
          && request.auth.token.email.matches('.*@lemonfilms[.]com$');
    }

    function isBootstrapAdmin() {
      return isLemonIdentity()
          && request.auth.token.email == 'billy@lemonfilms.com';
    }

    function hasUserProfile() {
      return isLemonIdentity()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isTeamMember() {
      return isLemonIdentity()
          && (isBootstrapAdmin()
              || (hasUserProfile()
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                     in ['admin', 'reader']));
    }

    function isAdmin() {
      return isBootstrapAdmin()
          || (hasUserProfile()
              && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
                 == 'admin');
    }

    function validUserProfile(data, uid) {
      return data.keys().hasOnly([
               'uid', 'email', 'displayName', 'photoURL', 'role',
               'createdAt', 'lastLoginAt'
             ])
          && data.uid == uid
          && data.email is string
          && data.email == request.auth.token.email
          && data.displayName is string
          && data.displayName.size() <= 200
          && (data.photoURL == null
              || (data.photoURL is string && data.photoURL.size() <= 2000))
          && data.role in ['admin', 'reader']
          && data.createdAt is string
          && data.lastLoginAt is string;
    }

    // True if a string field exists, is a string, and respects the max length.
    function validString(data, field, maxLen) {
      return field in data
          && data[field] is string
          && data[field].size() <= maxLen;
    }

    // True if the request timestamp is a valid server timestamp or ISO string.
    // Used to ensure clients write reasonable timestamps.
    function hasTimestamp(data, field) {
      return field in data
          && (data[field] is string || data[field] is timestamp);
    }

    function protectedAnalysisFields() {
      return [
        'analysis',
        'analysis_model',
        'analysis_provider',
        'analysis_schema_version',
        'analysis_version',
        'actual_cost_microusd',
        'actual_cost_usd',
        'calibration_profile',
        'content_hash',
        'identity_status',
        'lenses_enabled',
        'latest_version_id',
        'latest_source_file',
        'metadata',
        'model_provenance',
        'parser_version',
        'poster_cost_microusd',
        'poster_generated_at',
        'poster_last_error',
        'poster_model',
        'poster_request_id',
        'poster_requested_at',
        'poster_status',
        'poster_url',
        'poster_version_id',
        'pipeline_model_tier',
        'prompt_version',
        'queued_at_ms',
        'scoring_code_version',
        'selection_request',
        'storage_generation',
        'storage_path',
        '_storagePath',
        'tmdb_status',
        'triage',
        'usage',
        'v9_meta',
        'version_count',
        'version_id',
        'project_id',
        'trust_manifest',
        'trust_manifest_version',
        'server_trust_attestation',
        '_trust_authority'
      ];
    }

    // ── coverage_v1_reports (STAGING, read-only for clients) ─────────────
    // Coverage V1 engine output. Written ONLY by the VPS via the Admin SDK
    // (execution/upload_coverage_reports.py or the gated daemon route);
    // browser clients may read, never write. Kept separate from the
    // immutable uploaded_analyses record on purpose.
    match /coverage_v1_reports/{docId} {
      allow read: if isTeamMember();
      allow create, update, delete: if false;
    }

    // ── uploaded_analyses ─────────────────────────────────────────────────
    // Screenplay analysis documents.
    //
    // SECURITY RATIONALE:
    //   • Read: auth required — prevents enumeration by unauthenticated bots.
    //     The data is non-PII but auth gates reduce scraping risk.
    //   • Create/Update: auth + field validation. The `source_file` field is
    //     required and capped at 500 chars to prevent payload abuse.
    //   • Delete: blocked for clients. Soft-delete via _deleted_at field is
    //     the supported pattern. Hard deletes only via Admin SDK (quarantine).
    match /uploaded_analyses/{docId} {
      // READ: authenticated users only.
      allow read: if isTeamMember();

      // CREATE: authenticated + must include source_file.
      allow create: if isAdmin()
                    && 'source_file' in request.resource.data
                    && request.resource.data.source_file is string
                    && request.resource.data.source_file.size() <= 500
                    && !request.resource.data.keys().hasAny(protectedAnalysisFields());

      // UPDATE: authenticated + source_file must stay valid if present.
      // This covers soft-delete (_deleted_at), field patches, and restores.
      allow update: if isAdmin()
                    && !request.resource.data.diff(resource.data).affectedKeys()
                         .hasAny(protectedAnalysisFields())
                    && request.resource.data.source_file == resource.data.source_file
                    && (
                         !('source_file' in request.resource.data)
                         || (request.resource.data.source_file is string
                             && request.resource.data.source_file.size() <= 500)
                       );

      // DELETE: Admin SDK only. Clients use soft-delete or quarantine flags.
      allow delete: if false;
    }

    // ── immutable analysis versions ─────────────────────────────────────
    // Full snapshots written atomically with the top-level latest projection.
    // Browser clients may create a version once, but can never edit or delete it.
    match /uploaded_analyses/{docId}/versions/{versionId} {
      allow read: if isTeamMember();

      allow create, update, delete: if false;
    }

    // Separate server-write authority receipts prevent historical browser-created
    // version documents from self-promoting into trusted decision evidence.
    match /uploaded_analyses/{docId}/version_authorities/{versionId} {
      allow read: if isTeamMember();
      allow create, update, delete: if false;
    }

    // ── screenplay_feedback ──────────────────────────────────────────────
    // User feedback and notes on individual screenplays.
    //
    // SECURITY RATIONALE:
    //   • Text field capped at 10 000 chars to prevent storage abuse.
    //   • screenplayId is required and capped to prevent orphaned feedback.
    //   • Delete allowed (users should be able to remove their own notes).
    match /screenplay_feedback/{docId} {
      allow read: if isTeamMember();
      // Compatibility projection written only by calibrationManager.
      allow create, update, delete: if false;
    }

    // ── producer assessments ──────────────────────────────────────────────
    // Immutable producer judgments and their latest-per-project projection.
    // calibrationManager validates exact analysis identity and writes both.
    match /producer_assessments/{assessmentId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /producer_assessment_heads/{headId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // ── producer_profiles ────────────────────────────────────────────────
    // Producer calibration profiles (per-user lens configuration).
    //
    // SECURITY RATIONALE:
    //   • Name capped at 200 chars. No unbounded blobs allowed.
    //   • Auth required for all operations to prevent profile enumeration.
    match /producer_profiles/{docId} {
      allow read: if isAdmin();
      // Active profile pointers are published only by calibrationManager.
      allow create, update, delete: if false;

      match /versions/{versionId} {
        allow read: if isAdmin();
        // Candidate versions are immutable and server-authored.
        allow create, update, delete: if false;
      }

      match /publications/{publicationId} {
        allow read: if isAdmin();
        // Activation and rollback receipts are immutable and server-authored.
        allow create, update, delete: if false;
      }
    }

    // ── shared_views ─────────────────────────────────────────────────────
    // Share tokens for partner access via capability URLs.
    //
    // SECURITY RATIONALE:
    //   • Browser GET is denied. Partners resolve through shareManager, which
    //     requires a paired server-only authority receipt.
    //   • LIST requires dashboard authentication so public callers cannot
    //     enumerate live capability tokens.
    //   • CREATE/UPDATE are Admin-SDK-only through shareManager.
    //   • DELETE is Admin-SDK-only through shareManager.
    //   • EXPIRY is enforced by shareManager before any analysis is returned.
    //   • Doc size implicitly limited by the analysis snapshot structure.
    match /shared_views/{tokenId} {
      // Public resolution goes through shareManager, which requires a separate
      // Admin-only authority receipt and re-reads the canonical immutable version.
      allow get: if false;

      // Collection enumeration is restricted to dashboard users. Public partner
      // links resolve by token ID and never need list access.
      allow list: if isTeamMember();

      // Snapshots are created only by the Admin SDK from a sealed immutable version.
      allow create, update: if false;
      allow delete: if false;
    }

    // Paired server-authority receipts were never client-writable. They prevent
    // historical client-created share documents from impersonating sealed V9.
    match /share_authorities/{tokenId} {
      allow read, create, update, delete: if false;
    }

    // ── brain_verdicts ───────────────────────────────────────────────────
    // Billy's personal verdicts for Obsidian Brain calibration.
    //
    // SECURITY RATIONALE:
    //   • billyVerdict is enum-validated to prevent injection of arbitrary values.
    //   • screenplayId is required and capped.
    //   • No delete from client — verdicts are permanent once set.
    match /brain_verdicts/{screenplayId} {
      allow read: if isAdmin();
      // Compatibility projection written only by calibrationManager.
      allow create, update, delete: if false;
    }

    // ── _unrecognized_analyses (quarantine) ───────────────────────────────
    // Documents that failed type-guard validation.
    //
    // SECURITY RATIONALE:
    //   • Create: allowed (quarantine flow writes here before deleting source).
    //   • Read: allowed (settings panel shows quarantine count).
    //   • Update/Delete: Admin SDK only. Legacy quarantined docs shouldn't be
    //     modified or removed by the client — manual review required.
    match /_unrecognized_analyses/{docId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false; // Admin SDK only — manual review
    }

    // ── ingest-queue ─────────────────────────────────────────────────────
    // Job documents written by the VPS daemon via Admin SDK.
    //
    // SECURITY RATIONALE:
    //   • READ: auth required. Dashboard progress widgets poll this collection
    //     but there's no reason for unauthenticated access.
    //   • WRITE: completely blocked for clients. Only the VPS daemon and
    //     Cloud Functions write here (Admin SDK bypasses all rules).
    match /ingest-queue/{jobId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only
    }

    // ── system ───────────────────────────────────────────────────────────
    // Internal system documents: daily API budget counters, watchdog state.
    //
    // SECURITY RATIONALE:
    //   • READ: auth required (budget data is operational, not public).
    //   • WRITE: blocked. Only Admin SDK (Cloud Functions + VPS daemon).
    match /system/{docId} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only
    }

    // ── users ────────────────────────────────────────────────────────────
    // Google-authenticated team profiles and application roles.
    match /users/{uid} {
      // A Lemon user can read their own profile before it exists; admins can
      // inspect all profiles for role management.
      allow get: if isLemonIdentity()
                 && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();

      // First login creates exactly one safe role: Billy bootstraps as admin,
      // every other verified Lemon account starts as reader.
      allow create: if isLemonIdentity()
                    && request.auth.uid == uid
                    && validUserProfile(request.resource.data, uid)
                    && (
                         (isBootstrapAdmin() && request.resource.data.role == 'admin')
                         || (!isBootstrapAdmin() && request.resource.data.role == 'reader')
                       );

      // Admins may manage roles. Users may refresh their own display metadata
      // but cannot change uid, email, role, or creation time.
      allow update: if validUserProfile(request.resource.data, uid)
                    && (
                         isAdmin()
                         || (isTeamMember()
                             && request.auth.uid == uid
                             && request.resource.data.uid == resource.data.uid
                             && request.resource.data.email == resource.data.email
                             && request.resource.data.role == resource.data.role
                             && request.resource.data.createdAt == resource.data.createdAt)
                       );

      allow delete: if isAdmin() && request.auth.uid != uid;
    }

    // ── Catch-all deny ───────────────────────────────────────────────────
    // Any collection not explicitly matched above is completely locked down.
    // This prevents accidental data exposure if new collections are added
    // without updating security rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

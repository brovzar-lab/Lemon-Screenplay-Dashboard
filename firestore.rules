rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Internal studio dashboard — any authenticated user can read all collections.
    // Writes are locked to service accounts (agents use Admin SDK which bypasses rules).

    function isSignedIn() {
      return request.auth != null;
    }

    match /titles/{titleId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /coverage/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /mi_reports/{reportId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
